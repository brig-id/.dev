{
  "name": "brig·id workspace",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "workspaceFolder": "/workspaces/.dev",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/.dev,type=bind,consistency=cached",
  "mounts": [
    "source=${localWorkspaceFolder}/../.github,target=/workspaces/.github,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "BRIG_ID_ORG": "brig-id",
    "BRIG_ID_REPOS": ".github"
  },
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-github-actions",
        "github.copilot",
        "github.copilot-chat",
        "ms-vscode-remote.remote-containers"
      ]
    }
  },
  "forwardPorts": [
    3000,
    5173
  ],
  "remoteUser": "node",
  "postCreateCommand": "bash .devcontainer/setup-container.sh"
}
